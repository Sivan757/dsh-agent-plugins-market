{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // Client-owned artifacts (jsdom suites, the ui helpers and the ambient type
  // files) live beside packages/market-ui and belong to tsconfig.test.client.json.
  // The whole market-ui tree is excluded by directory: a new UI test is
  // client-owned by where it lives, not by being added to two lists.
  "include": ["packages/*/test/**/*.ts"],
  "exclude": [
    "packages/market-bundle/test/integration/client-document-translation.test.ts",
    "packages/market-bundle/test/integration/client-extension-preset-details.test.ts",
    "packages/market-bundle/test/integration/client-extension-preset-v5.test.ts",
    "packages/market-bundle/test/integration/client-extension-presets.test.ts",
    "packages/market-bundle/test/integration/client-hook-resource-card.test.ts",
    "packages/market-bundle/test/integration/client-hooks-status-panel.test.ts",
    "packages/market-bundle/test/integration/client-lsp-detail.test.ts",
    "packages/market-bundle/test/integration/client-mcp-detail-actions.test.ts",
    "packages/market-bundle/test/integration/client-mcp-detail.test.ts",
    "packages/market-bundle/test/integration/client-plugin-card.test.ts",
    "packages/market-bundle/test/integration/client-plugins-item-views.test.ts",
    "packages/market-bundle/test/integration/client-role-reasoning.test.ts",
    "packages/market-bundle/test/integration/client-server-config-policy.test.ts",
    "packages/market-bundle/test/integration/client-service-editor-parity.test.ts",
    "packages/market-bundle/test/integration/client-translation-binding-lifetime.test.ts",
    "packages/market-bundle/test/integration/client-translation-settings.test.ts",
    "packages/market-bundle/test/integration/client-view-models.test.ts",
    "packages/market-bundle/test/integration/user-panel-cache.test.ts",
    "packages/market-bundle/test/repo/markdown-crash.test.ts",
    "packages/market-ui/src/**/*.ts",
    "packages/market-ui/src/**/*.tsx",
    "packages/market-ui/test/**"
  ]
}
