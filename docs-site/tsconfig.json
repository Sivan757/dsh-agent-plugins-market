{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vitepress", "node"]
  },
  "include": ["**/*.mts", "**/*.ts", ".vitepress/**/*.ts", ".vitepress/**/*.vue"],
  "exclude": ["node_modules", "dist", "guide"]
}
