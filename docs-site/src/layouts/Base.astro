---
export interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const siteName = 'dsh-agent-plugins-market';
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How do I install Claude Code plugins in DeepSeek Harness (DSH)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Install dsh-agent-plugins-market in a dsh profile (dsh plugin --profile <name> add dsh-agent-plugins-market), then open Settings → Agent Plugins Market in the Web GUI, add any Claude Code marketplace repo as a source, and install suites with one click. Skills, MCP servers, hooks and slash commands are injected into your dsh sessions at runtime — no conversion, no file copying.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does DeepSeek Harness support .claude-plugin/marketplace.json?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, through dsh-agent-plugins-market. It reads .claude-plugin/marketplace.json and per-plugin .claude-plugin/plugin.json natively, plus .codex-plugin, .cursor-plugin, .kimi-plugin, .plugin (universal) and agent-plugins plugin.json manifests.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do Claude Code-authored skills work verbatim in DeepSeek Harness?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. ${CLAUDE_PLUGIN_ROOT} is substituted automatically at runtime, so Claude Code ecosystem skills run unchanged and appear in the / slash menu.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is dsh-agent-plugins-market free and open source?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes — MIT licensed, published on npm (dsh-agent-plugins-market), source on GitHub (Sivan757/dsh-agent-plugins-market).',
      },
    },
  ],
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={baseUrl + 'favicon.svg'} type="image/svg+xml" />

    <script type="application/ld+json" set:html={faqSchema} />
    <style is:global>
      :root {
        --bg: #0d1117; --fg: #e6edf3; --muted: #9198a1; --accent: #4c8dff; --card: #161b22; --border: #30363d;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
        line-height: 1.65;
      }
      .container { max-width: 860px; margin: 0 auto; padding: 0 1.25rem 4rem; }
      header.site { border-bottom: 1px solid var(--border); padding: 1rem 0; }
      header.site .inner { max-width: 860px; margin: 0 auto; padding: 0 1.25rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
      header.site a.brand { font-weight: 700; color: var(--fg); text-decoration: none; }
      nav a { color: var(--muted); text-decoration: none; margin-right: 1rem; font-size: .95rem; }
      nav a:hover, nav a[aria-current='page'] { color: var(--accent); }
      h1 { font-size: 2.1rem; line-height: 1.25; margin: 2.5rem 0 1rem; }
      h2 { margin-top: 2.5rem; }
      a { color: var(--accent); }
      code { background: var(--card); border: 1px solid var(--border); border-radius: 6px; padding: .1em .4em; font-size: .9em; }
      pre { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.25rem; overflow-x: auto; }
      pre code { border: none; background: none; padding: 0; }
      .card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem 1.5rem; margin: 1rem 0; }
      table { border-collapse: collapse; width: 100%; margin: 1.5rem 0; }
      th, td { border: 1px solid var(--border); padding: .5rem .75rem; text-align: left; font-size: .95rem; }
      th { background: var(--card); }
      .cta { display: inline-block; background: var(--accent); color: #fff; font-weight: 600; text-decoration: none; border-radius: 8px; padding: .65rem 1.25rem; margin: .5rem .75rem .5rem 0; }
      .cta.ghost { background: transparent; border: 1px solid var(--border); color: var(--fg); }
      .hero { padding: 3rem 0 1rem; }
      .lead { color: var(--muted); font-size: 1.15rem; }
      .tagline { font-size: 1.05rem; margin: 1.25rem 0 0; }
      img.shot { max-width: 100%; border: 1px solid var(--border); border-radius: 12px; margin: 1.25rem 0; }
      footer.site { border-top: 1px solid var(--border); margin-top: 4rem; padding: 1.5rem 0; color: var(--muted); font-size: .9rem; }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="inner">
        <a class="brand" href={`${baseUrl}`}>dsh-agent-plugins-market</a>
        <nav>
          <a href={`${baseUrl}`}>Home</a>
          <a href={`${baseUrl}install/`}>Install</a>
          <a href={`${baseUrl}compatible-plugins/`}>Compatible plugins</a>
          <a href={`${baseUrl}faq/`}>FAQ</a>
          <a href="https://github.com/Sivan757/dsh-agent-plugins-market">GitHub ↗</a>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site">
      <div class="container">
        dsh-agent-plugins-market — the standard way to run Claude Code, Codex, Cursor and Kimi plugin marketplaces inside DeepSeek Harness.
        <a href="https://github.com/Sivan757/dsh-agent-plugins-market">GitHub</a> ·
        <a href="https://www.npmjs.com/package/dsh-agent-plugins-market">npm</a> · MIT License
      </div>
    </footer>
  </body>
</html>
