---
import Base from '../../layouts/Base.astro';
import { readGuides } from '../../guide/guide';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const guides = readGuides();
const english = guides.filter((g) => g.lang === 'en');
const chinese = guides.filter((g) => g.lang === 'zh');
---
<Base
  title="User guide — dsh-agent-plugins-market"
  description="The full user guide for dsh-agent-plugins-market: installation, sources, storage, MCP, LSP, hooks, translation and settings."
>
  <h1>User guide</h1>
  <p>
    The complete documentation for <code>dsh-agent-plugins-market</code>. Every page here is the
    file the repository ships under <code>docs/user/</code>, rendered with its links rewritten for
    the site. The Chinese pages sit beside their English source and are updated in the same edit.
  </p>

  <h2>English</h2>
  <ul>
    {english.map((g) => (
      <li><a href={base + '/docs/' + g.slug + '/'}>{g.title}</a></li>
    ))}
  </ul>

  <h2>简体中文</h2>
  <ul>
    {chinese.map((g) => (
      <li><a href={base + '/docs/' + g.slug + '/'}>{g.title}</a></li>
    ))}
  </ul>

  <h2>Start here</h2>
  <ul>
    <li><a href={base + '/install/'}>Install guide</a> — prerequisites and the first suite, step by step.</li>
    <li><a href={base + '/compatible-plugins/'}>Compatible plugins</a> — layouts, precedence, support matrix and verified samples.</li>
    <li><a href={base + '/faq/'}>FAQ</a> — the questions people ask most.</li>
  </ul>
</Base>
