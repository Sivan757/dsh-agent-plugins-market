---
import { basename } from 'node:path';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { guideCounterpart, guideLang, guideSlug, guideTitle, readGuides, rewriteLinks } from '../../guide/guide';

export async function getStaticPaths() {
  const entries = await getCollection('userGuide');
  // The glob loader slugifies entry.id (it drops the dot in `usage.zh`), so the
  // route and the language come from the source file name, which stays verbatim.
  return entries.map((entry) => {
    if (entry.filePath === undefined) {
      throw new Error('guide: entry ' + entry.id + ' carries no filePath, so its route is unknown');
    }
    return { params: { slug: guideSlug(basename(entry.filePath)) }, props: { entry, file: basename(entry.filePath) } };
  });
}

const { entry, file } = Astro.props;
// A markdown entry always carries both; fail loudly rather than render an empty page.
if (entry.body === undefined || entry.rendered === undefined) {
  throw new Error('guide: ' + file + ' has no body or no rendered HTML');
}
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const guides = readGuides();
const lang = guideLang(file);
const title = guideTitle(entry.body, file);
const counterpart = guideCounterpart(file);
const currentSlug = guideSlug(file);
const html = rewriteLinks(entry.rendered.html, base);
const siblings = guides.filter((g) => g.lang === lang);

// The site chrome is English, but a Chinese guide page reads as Chinese: its
// sidebar headings and its links into the site are labelled in that language.
const zh = lang === 'zh';
const labels = {
  guide: zh ? '使用指南' : 'User guide',
  language: zh ? '语言' : 'Language',
  more: zh ? '更多' : 'More',
  install: zh ? '安装指南' : 'Install guide',
  compatible: zh ? '兼容的插件市场' : 'Compatible plugins',
  faq: zh ? '常见问题' : 'FAQ',
};
const languageLabel = zh ? '中文' : 'English';
const otherLabel = zh ? 'English' : '简体中文';
---
<Base
  title={title + ' — dsh-agent-plugins-market'}
  description={title + ' — user guide for dsh-agent-plugins-market in DeepSeek Harness.'}
>
  <div class="docsShell">
    <aside class="docsNav">
      <p class="docsNavTitle">{labels.guide}</p>
      <ul>
        {siblings.map((g) => (
          <li>
            <a
              href={base + '/docs/' + g.slug + '/'}
              aria-current={g.slug === currentSlug ? 'page' : undefined}
            >{g.title}</a>
          </li>
        ))}
      </ul>
      <p class="docsNavTitle">{labels.language}</p>
      <ul>
        <li><span class="langNow">{languageLabel}</span></li>
        {counterpart && <li><a href={base + '/docs/' + counterpart + '/'}>{otherLabel}</a></li>}
      </ul>
      <p class="docsNavTitle">{labels.more}</p>
      <ul>
        <li><a href={base + '/install/'}>{labels.install}</a></li>
        <li><a href={base + '/compatible-plugins/'}>{labels.compatible}</a></li>
        <li><a href={base + '/faq/'}>{labels.faq}</a></li>
      </ul>
    </aside>
    <article class="docsBody">
      <h1>{title}</h1>
      <div class="prose" set:html={html} />
    </article>
  </div>
</Base>
