---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<Base
  title="dsh-agent-plugins-market — Plugin marketplace and agent workspace for DeepSeek Harness"
  description="Install ecosystem suites and manage skills, commands, agent personas, MCP services and LSP servers in the DSH Web GUI."
>
  <section class="hero">
    <h1>Your agent toolkit, inside DeepSeek Harness</h1>
    <p class="tagline">
      <strong>A plugin marketplace and agent capability workspace for DeepSeek Harness (DSH).</strong>
    </p>
    <p class="lead">
      Reuse Claude Code, Codex, Cursor and Kimi suites, manage your own resources, and inspect running services in one workspace. Supported layouts are read in place without converting manifests or manually copying files.
    </p>
    <p>
      <a class="cta" href={`${base}install/`}>Get started</a>
      <a class="cta ghost" href="https://github.com/Sivan757/dsh-agent-plugins-market">GitHub</a>
      <a class="cta ghost" href="https://www.npmjs.com/package/dsh-agent-plugins-market">npm</a>
    </p>
    <img class="shot" src={`${base}assets/screenshot-workspace.png`} alt="The six-tab Agent Plugins workspace inside the DeepSeek Harness Web GUI" width="100%" />
  </section>

  <h2>What it solves</h2>
  <p>
    Add sources and install suites, create your own skills, commands and personas, and keep project-native resources in place. The workspace groups Market, Skills, Commands, Agent personas, MCP services and LSP servers into six tabs.
  </p>

  <h2>Supported plugin layouts</h2>
  <table>
    <tr><th>Layout</th><th>Manifest</th></tr>
    <tr><td>agent-plugins.org v1</td><td><code>plugin.json</code></td></tr>
    <tr><td>Claude Code market</td><td><code>.claude-plugin/marketplace.json</code> + <code>.claude-plugin/plugin.json</code></td></tr>
    <tr><td>Universal</td><td><code>.plugin/plugin.json</code></td></tr>
    <tr><td>Cursor</td><td><code>.cursor-plugin/plugin.json</code></td></tr>
    <tr><td>Kimi</td><td><code>.kimi-plugin/plugin.json</code></td></tr>
    <tr><td>Codex</td><td><code>.codex-plugin/plugin.json</code></td></tr>
    <tr><td>Skill collection</td><td>none (flat <code>SKILL.md</code> directories)</td></tr>
  </table>

  <h2>Quick install</h2>
  <pre><code>dsh plugin --profile &lt;name&gt; add dsh-agent-plugins-market</code></pre>
  <p>Requires Node.js 22+ and a DSH Web profile with the skill service. The <a href="https://github.com/Sivan757/dsh-agent-plugins-market#quick-start">README</a> lists the DSH host packages this plugin declares; feature availability depends on host services. See the <a href={`${base}install/`}>install guide</a> for details.</p>

  <h2>Learn more</h2>
  <ul>
    <li><a href={`${base}install/`}>Step-by-step install guide</a></li>
    <li><a href={`${base}compatible-plugins/`}>Known compatible plugin marketplaces</a></li>
    <li><a href={`${base}faq/`}>FAQ</a></li>
  </ul>
</Base>
