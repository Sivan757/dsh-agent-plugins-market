node_modules/
# Build output. Anchored: a bare `lib/` also matched source under a nested
# `src/lib/`, which silently kept a file out of a commit.
/lib/
client/*.js
client/*.map
client/*.css
*.tgz
.DS_Store
scripts/npm-token-setup.sh
coverage/
# playwright-cli capture state
.playwright-cli/
# IDE state
.idea/
*.local.*

# local pnpm store created by tooling runs
.pnpm-store/
