{
  "name": "dsh-agent-plugins-market",
  "icon": "./assets/dsh-agent-plugins.png",
  "description": "One-stop skills, subagent, MCP and LSP manager inside DeepSeek Harness (DSH), compatible with Claude Code, Codex, Cursor, Kimi and other agent plugin layouts.",
  "version": "0.9.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client",
    "schemas",
    "locale",
    "assets/dsh-agent-plugins.png",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.test.client.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "prebuild": "pnpm run typecheck",
    "build": "pnpm run clean && tsc -p tsconfig.json && pnpm run build:client",
    "build:client": "tsdown && node scripts/normalize-client-banner.mjs",
    "pretest": "pnpm run check:quick",
    "test": "vitest run",
    "test:contract": "vitest run tests/market-contracts.test.ts tests/routes.test.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "depcruise --validate .dependency-cruiser.cjs src",
    "check:host-alignment": "node scripts/check-host-alignment.mjs",
    "fix:host-alignment": "node scripts/check-host-alignment.mjs --fix",
    "check:quick": "pnpm run typecheck && pnpm run lint",
    "check:reuse": "node scripts/check-reuse.mjs",
    "check:refactor": "pnpm run check:quick && pnpm run format:check && pnpm run test:contract && pnpm run check:architecture && pnpm run check:reuse",
    "prepack": "pnpm run check:host-alignment && pnpm run build",
    "prepare": "node scripts/setup-git-hooks.mjs && pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sivan757/dsh-agent-plugins-market.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "dsh-marketplace",
    "dsh-plugin-marketplace",
    "deepseek-plugin",
    "deepseek-plugins",
    "agent-plugins",
    "agent-plugin",
    "plugin-marketplace",
    "marketplace",
    "claude-code",
    "claude-code-plugins",
    "claude-code-plugin-marketplace",
    "claude",
    "codex",
    "cursor",
    "skills",
    "mcp",
    "mcp-servers",
    "hooks",
    "suite",
    "ai-agents"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.2.0-rc.2",
