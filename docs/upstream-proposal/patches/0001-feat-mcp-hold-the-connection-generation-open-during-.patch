diff --git a/packages/mcp/mcp-client/tests/auth-config.spec.ts b/packages/mcp/mcp-client/tests/auth-config.spec.ts
new file mode 100644
index 0000000000..7425c4175c
--- /dev/null
+++ b/packages/mcp/mcp-client/tests/auth-config.spec.ts
@@ -0,0 +1,150 @@
+/**
+ * Tests for the `auth` config block on streamable-http servers: schema
+ * acceptance, transport construction with an OAuth provider wired to the
+ * credentials service, and config-shape passthrough. The OAuth protocol
+ * itself is covered by `oauth.spec.ts` and the SDK's own suite.
+ */
+import { describe, expect, it, vi, beforeEach } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+
+// vi.mock factories are hoisted above every import/const.
+const { MockClient, MockStreamableTransport, constructedOptions, constructedUrls } = vi.hoisted(() => {
+  const mockRequest = vi.fn(async (request: { method: string }) => {
+    if (request.method === 'tools/list') return { tools: [], nextCursor: undefined }
+    if (request.method === 'tools/call') return { content: [] }
+    throw new Error(`unexpected MCP request: ${request.method}`)
+  })
+  class MockClient {
+    onclose: (() => void) | undefined = undefined
+    request = mockRequest
+    setNotificationHandler = vi.fn()
+    connect = vi.fn(async () => {})
+    close = vi.fn(async function (this: { onclose?: () => void }) { this.onclose?.() })
+  }
+  const constructedOptions: Array<Record<string, unknown>> = []
+  const constructedUrls: Array<URL> = []
+  class MockStreamableTransport {
+    url: URL
+    options: Record<string, unknown>
+    onclose: (() => void) | undefined = undefined
+    onerror: ((error: Error) => void) | undefined = undefined
+    onmessage: ((message: unknown) => void) | undefined = undefined
+    start = vi.fn(async () => {})
+    send = vi.fn(async () => {})
+    close = vi.fn(async () => { this.onclose?.() })
+    finishAuth = vi.fn(async () => {})
+    constructor(url: URL, options?: Record<string, unknown>) {
+      this.url = url
+      this.options = options ?? {}
+      constructedUrls.push(url)
+      constructedOptions.push(this.options)
+    }
+  }
+  return { MockClient, MockStreamableTransport, constructedOptions, constructedUrls }
+})
+
+vi.mock('@modelcontextprotocol/sdk/client/index.js', () => ({
+  Client: MockClient,
+}))
+
+vi.mock('@modelcontextprotocol/sdk/client/streamableHttp.js', () => ({
+  StreamableHTTPClientTransport: MockStreamableTransport,
+}))
+
+import { apply, Config as ConfigSchema } from '@deepseek-ai/dsh-mcp-client/src/index.ts'
+import { createTransport } from '@deepseek-ai/dsh-mcp-client/src/transport.ts'
+
+async function mountRegistry(): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  return ctx
+}
+
+/** A credential store double exposing only the record surface the provider probes. */
+function createRecordStore() {
+  return {
+    describeRecord: async () => ({ configured: false, writable: true }),
+    readRecord: async () => undefined,
+    modifyRecord: async (_key: string, mutate: (current: unknown) => Promise<unknown>) => mutate(undefined),
+  }
+}
+
+function httpConfig(auth?: { enabled: boolean; scope?: string }): Parameters<typeof apply>[1] {
+  return {
+    transport: 'streamable-http',
+    serverName: 'srv',
+    url: 'https://mcp.example/mcp',
+    headers: {},
+    ...(auth === undefined ? {} : { auth }),
+    toolCallTimeoutMs: 60_000,
+    failOnStartupError: false,
+  }
+}
+
+beforeEach(() => {
+  constructedOptions.length = 0
+  constructedUrls.length = 0
+})
+
+describe('auth config schema', () => {
+  it('accepts an auth block with scope and storage and materializes nothing extra', () => {
+    const parsed = ConfigSchema({
+      transport: 'streamable-http', serverName: 'srv', url: 'https://x/mcp',
+      auth: { enabled: true, scope: 'a b', storage: { callbackPort: 0 } },
+    } as never) as unknown as Record<string, unknown>
+    expect(parsed.auth).toEqual({ enabled: true, scope: 'a b', storage: { callbackPort: 0 } })
+  })
+
+  it('leaves auth absent when omitted', () => {
+    const parsed = ConfigSchema({ transport: 'streamable-http', serverName: 'srv', url: 'https://x/mcp' } as never) as unknown as Record<string, unknown>
+    expect(parsed).not.toHaveProperty('auth')
+  })
+
+  it('rejects an auth block without enabled', () => {
+    // Raw input bypasses the TypeScript shape on purpose: the schema is the gate.
+    const raw = { transport: 'streamable-http', serverName: 'srv', url: 'https://x/mcp', auth: { scope: 'a' } } as unknown as Parameters<typeof ConfigSchema>[0]
+    expect(() => ConfigSchema(raw)).toThrow()
+  })
+})
+
+describe('transport construction with auth', () => {
+  it('returns no provider when auth is absent', () => {
+    const result = createTransport(httpConfig())
+    expect(result.oauthProvider).toBeUndefined()
+    expect(result.transport).toBeDefined()
+  })
+
+  it('wires a provider when auth is enabled', () => {
+    const { oauthProvider: provider } = createTransport(httpConfig({ enabled: true }), undefined)
+    expect(provider).toBeDefined()
+    expect(provider!.clientMetadata.client_name).toBe('DeepSeek Harness (dsh-mcp-client)')
+    // Default loopback: ephemeral port placeholder until the listener binds.
+    expect(provider!.redirectUrl).toBe('http://127.0.0.1:0/callback')
+  })
+
+  it('carries scope and a fixed callback port through the provider', () => {
+    const { oauthProvider: provider } = createTransport(httpConfig({ enabled: true, scope: 'repo' }), undefined, () => {})
+    expect(provider!.clientMetadata.scope).toBe('repo')
+  })
+
+  it('uses the mounted credentials service so state can persist', () => {
+    const store = createRecordStore()
+    const { oauthProvider: provider } = createTransport(httpConfig({ enabled: true }), store)
+    expect((provider as unknown as { store: unknown }).store).toBe(store)
+  })
+})
+
+describe('apply with an auth-enabled streamable-http server', () => {
+  it('activates against a mock transport and registers namespaced tools', async () => {
+    const ctx = await mountRegistry()
+    // The mocked transport answers connect immediately; the real tool sync is
+    // exercised in mcp-client.spec.ts — here the transport wiring is the point.
+    await apply(ctx, httpConfig({ enabled: true }))
+    expect(constructedUrls[0]?.toString()).toBe('https://mcp.example/mcp')
+    expect(constructedOptions[0]).toHaveProperty('authProvider')
+    await ctx.fiber.dispose()
+  })
+})
